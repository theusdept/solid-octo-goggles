+export const POLICY_VERSION='2026-11-15.1';
+export function policies(c) {
+  return {
+    terms:`FAST COIN SWAP — Terms (${POLICY_VERSION})\nOperator: ${c.operator}. Support: ${c.support}.\nThis bot is an independent interface to ChangeNOW. FAST COIN SWAP does not hold customer balances, private keys, or exchange deposits. ChangeNOW receives deposits and executes exchanges.\nUse only if legally eligible in your location, at least 18, and permitted by ChangeNOW's restrictions. ChangeNOW may require identity verification or suspend an exchange under its AML procedures. No promise of anonymity, approval, or guaranteed timing is made.\nCheck the asset, network, address and every memo/tag before confirmation and before sending. Blockchain transfers are generally irreversible. Standard quotes float until execution; final proceeds can change. Fixed quotes apply only within the provider's stated conditions and validity.\nThe displayed estimate reflects provider pricing and applicable provider/partner/network costs; your sending wallet may charge an additional fee. Partner commission, if configured by ChangeNOW, is included in provider pricing. No separate bot fee is added. No specific commission percentage is represented before provider confirmation.\nRead /refunds and /privacy. Canceling a conversation does not cancel an existing exchange or reverse a deposit. No investment advice is provided. Provider terms: https://changenow.io/terms-of-use`,
+    privacy:`FAST COIN SWAP — Privacy (${POLICY_VERSION})\nController/operator: ${c.operator}. Contact: ${c.support}.\nWe store your Telegram user ID, accepted policy version, exchange session, destination/refund addresses and memos you enter, provider order IDs, status data, delivery queue, and security/admin events to operate exchanges and resolve support issues. We do not request seed phrases or private keys.\nTelegram transports chat messages. ChangeNOW receives the asset/network pair, amount, destination/refund address and memo needed to execute your order. The bot does not send your Telegram ID or collect/store your IP address. Hosting infrastructure may process access metadata. Hosting: Railway when deployed there.\nCompleted/refunded orders and settled creation records are retained for up to 90 days after the last recorded activity; inactive user records for 90 days; update IDs for 30 days. Unresolved orders and uncertain creation records remain until resolved. Operational backups expire within 30 days under the deployment runbook. Provider and Telegram retention are independent.\nUse /delete to erase your inactive local profile; orders under investigation require resolution first. Contact support for access, correction, or deletion requests. Do not send sensitive wallet secrets. ChangeNOW privacy: https://changenow.io/privacy-policy`,
+    refunds:`FAST COIN SWAP — Refunds (${POLICY_VERSION})\nChangeNOW controls exchange execution and any cryptocurrency refunds. FAST COIN SWAP cannot reverse blockchain transfers or promise a refund.\nIf an exchange fails, is delayed, requires verification, is underpaid, or uses the wrong address/network/memo, contact support with the order ID: ${c.support}; provider: support@changenow.io or https://support.changenow.io. Never send seed phrases.\nEligibility, verification, recoverability, fees and timing depend on ChangeNOW's rules and the relevant network. Refunds may incur network costs. A failed status is not proof that funds were refunded; check the provider's refund status/hash. The bot makes no automatic refund or withdrawal requests.`
+  };
+}
diff --git a/runtime/provider.js b/runtime/provider.js
new file mode 100644
index 0000000..d35761c
--- /dev/null
+++ b/runtime/provider.js
@@ -0,0 +1,77 @@
+import {assetKey, pair, providerDecimal, compare, UserError} from './validation.js';
+export class ProviderError extends Error {
+  constructor(code, uncertain=false) {super(code);this.code=code;this.uncertain=uncertain;}
+}
+export class ChangeNOW {
+  constructor(key,{fetchImpl=fetch,sleep=ms=>new Promise(r=>setTimeout(r,ms)),clock=Date.now}={}) {
+    this.key=key;this.fetch=fetchImpl;this.sleep=sleep;this.clock=clock;this.cache=null;this.next=0;
+  }
+  async request(path,query={},body) {
+    const url=new URL('https://api.changenow.io/v2/'+path);
+    for(const [k,v] of Object.entries(query))if(v!==undefined)url.searchParams.set(k,String(v));
+    for(let attempt=0;attempt<3;attempt++) {
+      // Serialized bot execution plus this spacing stays below the published 30/s key limit.
+      const wait=this.next-this.clock();if(wait>0)await this.sleep(wait);this.next=this.clock()+100;
+      let res;
+      try { res=await this.fetch(url,{method:body?'POST':'GET',headers:{'x-changenow-api-key':this.key,'content-type':'application/json'},
+        ...(body?{body:JSON.stringify(body)}:{}),signal:AbortSignal.timeout(15000),redirect:'error'}); }
+      catch {if(body)throw new ProviderError('CREATE_UNCERTAIN',true);if(attempt===2)throw new ProviderError('NETWORK');continue;}
+      if(!res.ok) {
+        if(!body && (res.status===429||res.status>=500) && attempt<2) {
+          const seconds=Number(res.headers.get('retry-after'));
+          await this.sleep(Number.isFinite(seconds)&&seconds>0?Math.min(seconds*1000,30000):500*2**attempt);continue;
+        }
+        throw new ProviderError(res.status===403?'PERMISSION':res.status===401?'AUTH':res.status===429?'RATE_LIMIT':res.status>=500?'UNAVAILABLE':'REJECTED',Boolean(body&&res.status>=500));
+      }
+      try {return await res.json();}catch{throw new ProviderError(body?'CREATE_UNCERTAIN':'BAD_RESPONSE',Boolean(body));}
+    }
+  }
+  async currencies(flow='standard') {
+    if(this.cache?.flow===flow&&this.clock()-this.cache.time<60000)return this.cache.data;
+    const list=await this.request('exchange/currencies',{active:true,flow});
+    if(!Array.isArray(list))throw new ProviderError('BAD_RESPONSE');
+    const data=list.filter(a=>!a.isFiat&&/^[a-z0-9_-]{1,32}$/.test(a.ticker)&&/^[a-z0-9_-]{1,32}$/.test(a.network));
+    this.cache={flow,time:this.clock(),data};return data;
+  }
+  async select(input,side,flow='standard') {
+    const list=(await this.currencies(flow)).filter(a=>a[side]===true);
+    const key=input.toLowerCase().replace(/^\//,'');
+    const found=list.filter(a=>assetKey(a)===key||a.ticker===key||a.legacyTicker===key);
+    if(found.length!==1)throw new UserError(found.length?`Choose the network: ${found.map(assetKey).join(', ')}`:'Currency unavailable. Use /currencies TICKER to find active assets.');
+    return found[0];
+  }
+  async quote(a,b,amount,flow='standard') {
+    if(assetKey(a)===assetKey(b))throw new UserError('Choose two different assets or networks.');
+    const p=pair(a,b,flow),range=await this.request('exchange/range',p);
+    const min=providerDecimal(range.minAmount,true),max=range.maxAmount==null?null:providerDecimal(range.maxAmount,true);
+    if(compare(amount,min)<0 || (max!==null&&compare(amount,max)>0))throw new UserError(`Amount must be at least ${min}${max?` and no more than ${max}`:''} ${a.ticker.toUpperCase()}.`);
+    const q=await this.request('exchange/estimated-amount',{...p,fromAmount:amount,type:'direct',...(flow==='fixed-rate'?{useRateId:true}:{})});
+    for(const [k,v] of Object.entries(p))if(q[k]!==v)throw new ProviderError('PAIR_MISMATCH');
+    if(compare(providerDecimal(q.fromAmount),amount)!==0)throw new ProviderError('AMOUNT_MISMATCH');
+    const toAmount=providerDecimal(q.toAmount);
+    if(flow==='fixed-rate'&&(!q.rateId||!Number.isFinite(Date.parse(q.validUntil))||Date.parse(q.validUntil)<=this.clock()))throw new ProviderError('EXPIRED_RATE');
+    return {...q,toAmount,quotedAt:this.clock()};
+  }
+  async validate(asset,address) {
+    const r=await this.request('validate/address',{currency:asset.network,address});
+    if(r.result!==true)throw new UserError('Address validation failed for this network. Check the address and selected network.');
+  }
+  async create(s) {
+    const body={...pair(s.from,s.to,s.flow),fromAmount:s.amount,address:s.address,type:'direct',
+      ...(s.extraId?{extraId:s.extraId}:{}),...(s.refundAddress?{refundAddress:s.refundAddress}:{}),
+      ...(s.refundExtraId?{refundExtraId:s.refundExtraId}:{}),...(s.flow==='fixed-rate'?{rateId:s.quote.rateId}:{})};
+    const r=await this.request('exchange',{},body);
+    try {
+    if(!/^[a-z0-9]{14,64}$/.test(r.id)||typeof r.payinAddress!=='string'||!r.payinAddress||r.payoutAddress!==s.address||
+      Object.entries(pair(s.from,s.to,s.flow)).some(([k,v])=>r[k]!==v)||
+      (s.from.hasExternalId&&!r.payinExtraId)||compare(providerDecimal(r.fromAmount),s.amount)!==0)
+      throw new ProviderError('CREATE_UNCERTAIN',true);
+    if(s.flow==='fixed-rate'&&(!r.validUntil||!Number.isFinite(Date.parse(r.validUntil))))throw new Error('Missing validity');
+    return {...r,toAmount:providerDecimal(r.toAmount)};
+    } catch {throw new ProviderError('CREATE_UNCERTAIN',true);}
+  }
+  async status(id) {
+    const r=await this.request('exchange/by-id',{id});
+    if(r.id!==id||typeof r.status!=='string')throw new ProviderError('BAD_RESPONSE');return r;
+  }
+}
diff --git a/runtime/server.js b/runtime/server.js
new file mode 100644
index 0000000..e0f329f
--- /dev/null
+++ b/runtime/server.js
@@ -0,0 +1,31 @@
+import {createServer} from 'node:http';
+import {timingSafeEqual} from 'node:crypto';
+const escape=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+export function server(bot,c,{enqueue=fn=>fn(),healthy=()=>true,onCallback=async()=>{}}={}) {
+  return createServer(async(req,res)=>{
+    const path=(req.url||'').split('?')[0];
+    res.setHeader('x-content-type-options','nosniff');res.setHeader('cache-control','no-store');
+    res.setHeader('content-security-policy',"default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'");
+    if(req.method==='GET'&&path==='/health'){
+      res.writeHead(healthy()?200:503,{'content-type':'application/json'});res.end(JSON.stringify({status:healthy()?'ok':'busy',liveOrders:bot.ready(),product:'FASTCOINSWAPbot'}));return;
+    }
+    if(req.method==='GET'&&['/','/terms','/privacy','/refunds'].includes(path)){
+      const key=path==='/'?'terms':path.slice(1);
+      res.writeHead(200,{'content-type':'text/html; charset=utf-8'});
+      res.end(`<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>FAST COIN SWAP</title><style>body{max-width:760px;margin:40px auto;padding:20px;background:#071626;color:#eef7ff;font:17px/1.7 system-ui}a{color:#54e3ce}pre{white-space:pre-wrap;font:inherit}</style><nav><a href="/terms">Terms</a> · <a href="/privacy">Privacy</a> · <a href="/refunds">Refunds</a></nav><pre>${escape(bot.policy[key])}</pre></html>`);return;
+    }
+    if(req.method!=='POST'||path!=='/telegram'){res.writeHead(404);res.end();return;}
+    const supplied=Buffer.from(String(req.headers['x-telegram-bot-api-secret-token']||'')),expected=Buffer.from(c.secret);
+    if(supplied.length!==expected.length||!timingSafeEqual(supplied,expected)){res.writeHead(403);res.end();return;}
+    if(!String(req.headers['content-type']).startsWith('application/json')){res.writeHead(415);res.end();return;}
+    if(!healthy()){res.writeHead(503);res.end();return;}
+    try{
+      let size=0;const chunks=[];req.setTimeout(10000,()=>req.destroy());
+      for await(const chunk of req){size+=chunk.length;if(size>65536){res.writeHead(413);res.end();return;}chunks.push(chunk);}
+      let update;try{update=JSON.parse(Buffer.concat(chunks).toString());}catch{res.writeHead(400);res.end();return;}
+      if(!update||!Number.isSafeInteger(update.update_id)){res.writeHead(400);res.end();return;}
+      if(typeof update.callback_query?.id==='string')await onCallback(update.callback_query.id);
+      await enqueue(()=>bot.receive(update));res.writeHead(200);res.end('ok');
+    }catch{if(!res.headersSent)res.writeHead(500);res.end();}
+  });
+}
diff --git a/runtime/store.js b/runtime/store.js
new file mode 100644
index 0000000..dae6f17
--- /dev/null
+++ b/runtime/store.js
@@ -0,0 +1,65 @@
+import {DatabaseSync} from 'node:sqlite';
+import {mkdirSync} from 'node:fs';
+import {dirname} from 'node:path';
+export class Store {
+  constructor(path=':memory:') {
+    if(path!==':memory:')mkdirSync(dirname(path),{recursive:true,mode:0o700});
+    this.db=new DatabaseSync(path);
+    this.db.exec(`PRAGMA journal_mode=WAL; PRAGMA busy_timeout=5000;
+      CREATE TABLE IF NOT EXISTS users(id TEXT PRIMARY KEY, session TEXT NOT NULL, accepted TEXT, touched INTEGER NOT NULL);
+      CREATE TABLE IF NOT EXISTS admins(id TEXT PRIMARY KEY);
+      CREATE TABLE IF NOT EXISTS updates(id INTEGER PRIMARY KEY, state TEXT NOT NULL, created INTEGER NOT NULL);
+      CREATE TABLE IF NOT EXISTS attempts(id TEXT PRIMARY KEY, user_id TEXT NOT NULL, state TEXT NOT NULL, result TEXT, created INTEGER NOT NULL);
+      CREATE TABLE IF NOT EXISTS orders(id TEXT PRIMARY KEY,user_id TEXT NOT NULL,data TEXT NOT NULL,status TEXT NOT NULL,touched INTEGER NOT NULL);
+      CREATE TABLE IF NOT EXISTS notifications(id INTEGER PRIMARY KEY,user_id TEXT NOT NULL,body TEXT NOT NULL);
+      CREATE TABLE IF NOT EXISTS audit(id INTEGER PRIMARY KEY,actor TEXT NOT NULL,action TEXT NOT NULL,target TEXT,created INTEGER NOT NULL);
+      CREATE TABLE IF NOT EXISTS limits(user_id TEXT NOT NULL, bucket INTEGER NOT NULL, count INTEGER NOT NULL, PRIMARY KEY(user_id,bucket));
+      CREATE TABLE IF NOT EXISTS settings(key TEXT PRIMARY KEY,value TEXT NOT NULL);
+      CREATE INDEX IF NOT EXISTS orders_user ON orders(user_id);
+    `);
+    // A process can crash after a provider accepted POST: never repeat it automatically.
+    this.db.exec("UPDATE attempts SET state='uncertain' WHERE state='creating'; UPDATE updates SET state='interrupted' WHERE state='processing';");
+  }
+  get(id) {const r=this.db.prepare('SELECT * FROM users WHERE id=?').get(id);return r?{session:JSON.parse(r.session),accepted:r.accepted}:{session:{},accepted:null};}
+  save(id,s,accepted=this.get(id).accepted) {this.db.prepare('INSERT INTO users VALUES(?,?,?,?) ON CONFLICT(id) DO UPDATE SET session=excluded.session,accepted=excluded.accepted,touched=excluded.touched').run(id,JSON.stringify(s),accepted,Date.now());}
+  claimUpdate(id) {return this.db.prepare("INSERT OR IGNORE INTO updates VALUES(?,'processing',?)").run(id,Date.now()).changes===1;}
+  finishUpdate(id) {this.db.prepare("UPDATE updates SET state='done' WHERE id=?").run(id);}
+  attempt(id) {const r=this.db.prepare('SELECT * FROM attempts WHERE id=?').get(id);return r?{...r,result:r.result?JSON.parse(r.result):null}:null;}
+  begin(id,user) {return this.db.prepare("INSERT OR IGNORE INTO attempts VALUES(?,?,'creating',NULL,?)").run(id,user,Date.now()).changes===1;}
+  settle(id,state,result=null) {this.db.prepare('UPDATE attempts SET state=?,result=? WHERE id=?').run(state,result?JSON.stringify(result):null,id);}
+  blocked(user) {return this.db.prepare("SELECT id FROM attempts WHERE user_id=? AND state IN ('creating','uncertain') LIMIT 1").get(user);}
+  order(id,user) {const r=this.db.prepare('SELECT * FROM orders WHERE id=? AND user_id=?').get(id,user);return r?{...r,data:JSON.parse(r.data)}:null;}
+  putOrder(user,data) {const prior=this.db.prepare('SELECT user_id FROM orders WHERE id=?').get(data.id);if(prior&&prior.user_id!==user)throw new Error('Order ownership conflict');this.db.prepare('INSERT INTO orders VALUES(?,?,?,?,?) ON CONFLICT(id) DO UPDATE SET data=excluded.data,status=excluded.status,touched=excluded.touched').run(data.id,user,JSON.stringify(data),data.status||'waiting',Date.now());}
+  list(user) {return this.db.prepare('SELECT * FROM orders WHERE user_id=? ORDER BY touched DESC LIMIT 20').all(user);}
+  watched() {return this.db.prepare("SELECT * FROM orders WHERE status NOT IN ('finished','refunded') ORDER BY touched LIMIT 100").all().map(r=>({...r,data:JSON.parse(r.data)}));}
+  changeOrder(row,data,message) {
+    this.db.exec('BEGIN IMMEDIATE');try {
+      this.putOrder(row.user_id,data);
+      if(data.status!==row.status)this.db.prepare('INSERT INTO notifications(user_id,body) VALUES(?,?)').run(row.user_id,message);
+      this.db.exec('COMMIT');
+    }catch(e){this.db.exec('ROLLBACK');throw e;}
+  }
+  notify(user,body) {this.db.prepare('INSERT INTO notifications(user_id,body) VALUES(?,?)').run(user,body);}
+  pending() {return this.db.prepare('SELECT * FROM notifications ORDER BY id LIMIT 100').all();}
+  sent(id) {this.db.prepare('DELETE FROM notifications WHERE id=?').run(id);}
+  isAdmin(id) {return Boolean(this.db.prepare('SELECT 1 FROM admins WHERE id=?').get(id));}
+  admin(id,add) {this.db.prepare(add?'INSERT OR IGNORE INTO admins VALUES(?)':'DELETE FROM admins WHERE id=?').run(id);}
+  admins() {return this.db.prepare('SELECT id FROM admins').all().map(x=>x.id);}
+  audit(actor,action,target='') {this.db.prepare('INSERT INTO audit(actor,action,target,created) VALUES(?,?,?,?)').run(actor,action,target,Date.now());}
+  pause(value) {if(value!==undefined)this.db.prepare("INSERT INTO settings VALUES('paused',?) ON CONFLICT(key) DO UPDATE SET value=excluded.value").run(String(value));return this.db.prepare("SELECT value FROM settings WHERE key='paused'").get()?.value==='true';}
+  counts() {return {users:this.db.prepare('SELECT count(*) n FROM users').get().n,orders:this.db.prepare('SELECT count(*) n FROM orders').get().n,uncertain:this.db.prepare("SELECT count(*) n FROM attempts WHERE state='uncertain'").get().n};}
+  allow(user, now=Date.now()) {
+    const bucket=Math.floor(now/60000);
+    this.db.prepare('INSERT INTO limits VALUES(?,?,1) ON CONFLICT(user_id,bucket) DO UPDATE SET count=count+1').run(user,bucket);
+    return this.db.prepare('SELECT count FROM limits WHERE user_id=? AND bucket=?').get(user,bucket).count<=20;
+  }
+  cleanup(now=Date.now()) {
+    this.db.prepare('DELETE FROM limits WHERE bucket<?').run(Math.floor(now/60000)-10);
+    this.db.prepare('DELETE FROM updates WHERE created<?').run(now-30*86400000);
+    this.db.prepare("DELETE FROM orders WHERE status IN ('finished','refunded') AND touched<?").run(now-90*86400000);
+    this.db.prepare("DELETE FROM attempts WHERE state IN ('created','rejected') AND created<?").run(now-90*86400000);
+    this.db.prepare('DELETE FROM audit WHERE created<?').run(now-90*86400000);
+    this.db.prepare("DELETE FROM users WHERE touched<? AND id NOT IN (SELECT user_id FROM orders UNION SELECT user_id FROM attempts WHERE state IN ('uncertain','creating'))").run(now-90*86400000);
+  }
+  close(){this.db.close();}
+}
diff --git a/runtime/telegram.js b/runtime/telegram.js
new file mode 100644
index 0000000..f8dfd0e
--- /dev/null
+++ b/runtime/telegram.js
@@ -0,0 +1,26 @@
+export class Telegram {
+  constructor(token,{fetchImpl=fetch}={}){this.token=token;this.fetch=fetchImpl;this.blockedUntil=0;}
+  async call(method,body){
+    const res=await this.fetch(`https://api.telegram.org/bot${this.token}/${method}`,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body),signal:AbortSignal.timeout(15000),redirect:'error'});
+    let data;try{data=await res.json();}catch{throw new Error('Telegram response invalid');}
+    if(!res.ok||!data.ok){
+      const e=new Error('Telegram request failed');e.code=data.error_code;
+      if(e.code===429)this.blockedUntil=Date.now()+Math.min(Number(data.parameters?.retry_after||5),3600)*1000;
+      throw e;
+    }
+    return data.result;
+  }
+  async flush(store){
+    if(Date.now()<this.blockedUntil)return;
+    for(const item of store.pending()){
+      try{
+        await this.call('sendMessage',{chat_id:item.user_id,...JSON.parse(item.body),link_preview_options:{is_disabled:true}});store.sent(item.id);
+        await new Promise(r=>setTimeout(r,1100));
+      }catch(e){
+        // A blocked user cannot receive updates; their saved order remains accessible if they return.
+        if(e.code===403){store.sent(item.id);store.audit('system','notification_blocked',item.user_id);continue;}
+        store.audit('system','notification_retry');break;
+      }
+    }
+  }
+}
diff --git a/runtime/validation.js b/runtime/validation.js
new file mode 100644
index 0000000..f487662
--- /dev/null
+++ b/runtime/validation.js
@@ -0,0 +1,53 @@
+export class UserError extends Error {}
+export function decimal(value, allowZero = false) {
+  const s = String(value);
+  if (!/^(0|[1-9]\d{0,17})(\.\d{1,18})?$/.test(s) || (!allowZero && !/[1-9]/.test(s)))
+    throw new UserError('Enter a positive decimal amount, without commas or exponent notation (up to 18 decimal places).');
+  return s;
+}
+export function compare(a, b) {
+  const scaled = x => { const [i, f=''] = decimal(x, true).split('.'); return BigInt(i + f.padEnd(18,'0')); };
+  const x = scaled(a), y = scaled(b);
+  return x < y ? -1 : x > y ? 1 : 0;
+}
+export function providerDecimal(x, zero=false) {
+  if (typeof x === 'number') {
+    if (!Number.isFinite(x) || x < 0) throw new Error('Invalid provider amount');
+    const [m,e='0'] = String(x).split('e');
+    if (e !== '0') {
+      const [i,f=''] = m.split('.'), digits=i+f, pos=i.length+Number(e);
+      x=pos<=0?'0.'+'0'.repeat(-pos)+digits:pos>=digits.length?digits+'0'.repeat(pos-digits.length):digits.slice(0,pos)+'.'+digits.slice(pos);
+    }
+  }
+  return decimal(String(x),zero);
+}
+export function field(s, label='Address or memo') {
+  if (typeof s !== 'string' || !/^[\x21-\x7e]{1,256}$/.test(s)) throw new UserError(`${label} must be 1–256 visible characters with no spaces.`);
+  return s;
+}
+export function userId(s) {
+  if (!/^[1-9]\d{0,15}$/.test(String(s)) || !Number.isSafeInteger(Number(s))) throw new UserError('Invalid Telegram user ID.');
+  return String(s);
+}
+export const assetKey = a => `${a.ticker}:${a.network}`;
+export const assetLabel = a => `${a.ticker.toUpperCase()} on ${a.network.toUpperCase()}`;
+export function pair(a,b,flow='standard') {
+  return {fromCurrency:a.ticker,fromNetwork:a.network,toCurrency:b.ticker,toNetwork:b.network,flow};
+}
+export function config(env=process.env) {
+  const required=k=>{if(!env[k])throw new Error(`Missing ${k}`);return env[k];};
+  const flag=k=>{if(env[k] && !['true','false'].includes(env[k]))throw new Error(`Invalid ${k}`);return env[k]==='true';};
+  const url=new URL(required('PUBLIC_URL'));
+  if(url.protocol!=='https:')throw new Error('PUBLIC_URL must use HTTPS');
+  const secret=required('TELEGRAM_WEBHOOK_SECRET');
+  if(!/^[A-Za-z0-9_-]{32,256}$/.test(secret))throw new Error('Invalid TELEGRAM_WEBHOOK_SECRET');
+  const c={token:required('TELEGRAM_BOT_TOKEN'),key:env.CHANGENOW_API_KEY||'',owner:userId(required('OWNER_TELEGRAM_ID')),
+    url:url.origin,secret,db:env.DB_PATH||'/data/fastcoinswap.sqlite',port:Number(env.PORT||3000),
+    support:required('SUPPORT_CONTACT'),operator:required('OPERATOR_NAME'),live:flag('LIVE_EXCHANGES_ENABLED'),
+    approved:flag('PROVIDER_ACCESS_CONFIRMED')&&flag('POLICIES_APPROVED'),fixed:flag('FIXED_RATE_ENABLED')};
+  if(!/^\d+:[\w-]{20,}$/.test(c.token))throw new Error('Invalid TELEGRAM_BOT_TOKEN');
+  if(!Number.isInteger(c.port)||c.port<1||c.port>65535)throw new Error('Invalid PORT');
+  if(c.live && (!c.approved||!c.key))throw new Error('Live exchange prerequisites missing');
+  if(c.fixed && !flag('FIXED_RATE_ACCESS_CONFIRMED'))throw new Error('Fixed-rate permission not confirmed');
+  return c;
+}
