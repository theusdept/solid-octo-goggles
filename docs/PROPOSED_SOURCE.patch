+read.hears([/(.*)/gi, messages.read], async ctx => {
+  if (await app.msgInterceptor.interceptedByMsgAge(ctx)) { return; }
+
+  const { message } = ctx;
+
+  const { from } = message;
+  const user = from;
+  const { id: userId, username } = user;
+
+  try {
+    const userInDB = await UserModel.findOne({ userId: user.id });
