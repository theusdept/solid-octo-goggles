+    if (!userInDB) {
+      await UserModel.create({ userId, username });
+    }
+  } catch (e) {
+    logger.error(`${__filename}: ${e}`);
+  }
+
+  ctx.session.userId = userId;
+  await app.analytics.trackRead(ctx);
+
+  await ctx.scene.enter(scenes.start);
+
+});
+
+export default read;
